msgid ""
"Conectar pacientes oncológicos e familiares a uma rede de apoio acessível e "
"humanizada."
msgstr "Mettere in contatto i pazienti oncologici e le loro famiglie con una rete di supporto accessibile e umana."

msgid "Visão"
