msgid ""
"Aqui você encontra instituições, hospitais e organizações que oferecem "
"suporte durante o tratamento de câncer."
msgstr ""
"Hier finden Sie Einrichtungen, Krankenhäuser und Organisationen, die "
"während der Krebsbehandlung Unterstützung anbieten."

msgid "Saiba mais"
msgstr "Mehr erfahren"

msgid "Ver instituição"
msgstr "Einrichtung ansehen"

msgid "Nenhuma instituição encontrada"
